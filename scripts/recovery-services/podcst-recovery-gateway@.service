[Unit]
Description=Podcst recovery admission gateway (%i)

[Service]
User=svc-podcst-gateway
Group=svc-podcst-gateway
StateDirectory=podcst-gateway
WorkingDirectory=/opt/podcst/recovery/%i
ExecStart=/usr/local/bin/bun --no-env-file /opt/podcst/recovery/%i/scripts/recovery-gateway.js /var/lib/podcst-gateway/config.json
ReadOnlyPaths=/var/lib/podcst-gateway

[Install]
WantedBy=multi-user.target
