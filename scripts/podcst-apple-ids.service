[Unit]
Description=Podcst check for Apple IDs Apple no longer lists
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=svc-podcst
Group=svc-podcst
Environment=HOME=/var/lib/podcst
EnvironmentFile=/etc/podcst/app.env
WorkingDirectory=/opt/podcst
ExecStart=/usr/local/bin/bun run scripts/clear-unlisted-apple-ids.ts --apply
TimeoutStartSec=2h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/opt/podcst
ReadWritePaths=/var/lib/podcst
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=podcst-apple-ids
