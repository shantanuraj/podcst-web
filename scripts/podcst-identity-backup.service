[Unit]
Description=Podcst id-map snapshot (podcasts + episodes identity) to S3
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=svc-podcst
Group=svc-podcst
EnvironmentFile=/etc/podcst/backup.env
ExecStart=/opt/podcst/scripts/podcst-identity-backup.sh
