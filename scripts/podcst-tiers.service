[Unit]
Description=Podcst tier recompute (is_essential)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=svc-podcst
Group=svc-podcst
EnvironmentFile=/opt/podcst/.env.local
ExecStart=/usr/local/bin/bun run /opt/podcst/scripts/refresh-tiers.ts
WorkingDirectory=/opt/podcst
