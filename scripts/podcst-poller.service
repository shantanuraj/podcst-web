[Unit]
Description=Podcst feed poller daemon
After=network.target postgresql.service

[Service]
User=svc-podcst
Group=svc-podcst
Environment=HOME=/var/lib/podcst
EnvironmentFile=/etc/podcst/app.env
WorkingDirectory=/opt/podcst
ExecStart=/usr/local/bin/bun run scripts/poll-feeds.ts --daemon
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/opt/podcst
ReadWritePaths=/var/lib/podcst
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
