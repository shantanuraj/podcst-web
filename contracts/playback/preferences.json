          "https://example.com/a.xml": {
            "speed": 1.5,
            "volumeBoost": true,
            "trimSilence": false
          },
          "https://private.example/b.xml?token=secret": {
            "speed": 1.5,
            "volumeBoost": true,
            "trimSilence": false
